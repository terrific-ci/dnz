# Where Prometheus reaches DNZ's metrics, as host:port:
#   the own listen address (metrics.addr), e.g. dns1.example.internal:9153
#   or the HTTP API (metrics.api), e.g. dns1.example.internal:8080
DNZ_TARGET=dns1.example.internal:9153
# http, or https for the HTTP API behind TLS.
DNZ_SCHEME=http
# The metrics token (Settings → General → Prometheus metrics, or
# `dnz settings metrics --new-token`). Needed for the HTTP API; leave empty
# for an own listen address without a token.
DNZ_METRICS_TOKEN=
# Shown as the `dnz` label on every series.
DNZ_NAME=dns1
GRAFANA_PASSWORD=change-me
